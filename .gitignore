# ==========================================
# ⚡ NODE.JS, VITE & TYPESCRIPT (Front & Back)
# ==========================================

# Cache e Dependências
**/node_modules/
.pnpm-store/

# Arquivos de Variáveis de Ambiente (SEGURANÇA!)
**/.env
**/.env.local
**/.env.*.local

# Compilação e Produção
**/dist/
**/dist-ssr/
**/.cache/

# Logs de Erro do NPM / Yarn / PNPM
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*

# ==========================================
# ☁️ .NET & VISUAL STUDIO (Back-end C#)
# ==========================================

# Pastas de Compilação e Binários (MUITO IMPORTANTE)
**/bin/
**/obj/

# Arquivos de Configuração de Usuário e Cache do VS
**/.vs/
**/*.user
**/*.userosscache
**/*.suo
**/*.userprefs

# Arquivos gerados pelo build de publicação do .NET
**/publish/
**/out/

# Arquivos de Log e Relatórios do .NET
**/*.log
**/*.vshost.exe*
**/*.vshost.bi*

# ==========================================
# 💻 SISTEMA OPERACIONAL & EDITORES
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
